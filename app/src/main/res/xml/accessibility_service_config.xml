<?xml version="1.0" encoding="utf-8"?>
<!--
  NOTE: android:packageNames is intentionally NOT set.

  Restricting this service to a package list would also restrict which
  TYPE_WINDOW_STATE_CHANGED events the framework delivers, so the Phase 2
  activity logger would only ever see one app and could never detect a
  cross-app routine. Filtering happens in code instead.

  Event types:
    typeWindowStateChanged  — Phase 2 foreground capture + Phase 3 action trigger
    typeWindowContentChanged— reserved for observing list/content updates
    typeViewClicked         — Phase 3.1 click capture
    typeViewTextChanged     — Phase 3.1 typed-text capture

  Flags:
    flagReportViewIds is REQUIRED for AccessibilityNodeInfo.viewIdResourceName
    to return anything; without it every captured viewId would be null and the
    sequence log would be far less useful.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description" />
